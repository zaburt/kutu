%fieldset
  %legend
    = t('generic.edit_model', :name => Article.model_name.human)
    \-
    = @article.title

  = render 'form'

  .grid-x
    .small-12.cell.small-offset-1
      = link_to t('show'), @article, :class => 'button'
      = link_to t('additional_pictures'), additional_pictures_article_path(@article), :class => 'button'
      = link_to t('back'), articles_path, :class => 'button'

